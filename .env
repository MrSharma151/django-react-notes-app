# -------------------------
# Database Configuration
# -------------------------

# MySQL database name
DB_NAME=test_db

# MySQL username
DB_USER=root

# MySQL password
DB_PASSWORD=root

# MySQL internal port (default)
DB_PORT=3306

# ❗ Most important:
# Use SERVICE NAME ("db") for Docker internal DNS, NOT container_name ("db_cont")
DB_HOST=db


# -------------------------
# Django Settings
# -------------------------

# Secret key (IMPORTANT: change this in real production)
SECRET_KEY=your-secret-key-here

# Allowed hosts (update your domain or use * for dev)
ALLOWED_HOSTS=localhost,127.0.0.1

# Debug mode (False recommended for production)
DEBUG=True

